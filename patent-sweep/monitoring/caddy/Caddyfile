# Entrada HTTPS de producción (ADR-010). Caddy obtiene y renueva solo los certificados de Let's Encrypt
# y redirige HTTP → HTTPS. Los dominios salen del .env del servidor (API_DOMINIO, GRAFANA_DOMINIO).
{
	admin off
}

(seguridad) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-X-Powered-By
	}
	encode gzip
	log
}

{$API_DOMINIO} {
	import seguridad
	reverse_proxy api-patent-sweep:{$API_PUERTO}
}

{$GRAFANA_DOMINIO} {
	import seguridad
	reverse_proxy grafana:3000
}
