        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Pausas de GC y CPU del proceso",
      "description": "",
      "datasource": {
        "type": "prometheus",
