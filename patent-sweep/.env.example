# Copie este archivo como .env (cp .env.example .env) y cambie los valores marcados.
# El archivo .env NO se sube al repositorio. Los valores de abajo son solo marcadores de posición.

# Perfil de Spring activo: dev (más logs) o prod.
SPRING_PROFILES_ACTIVE=dev

# Puerto en el que se expone la API. Se evita el 8080 por defecto (recomendación OWASP).
API_PUERTO=8085

# Puerto interno de Actuator (/actuator/prometheus). No se publica; debe ser distinto de API_PUERTO (ADR-010).
MANAGEMENT_PUERTO=9091

# Base de datos PostgreSQL. DB_HOST es el nombre del servicio en docker-compose.yml.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=patent_sweep
DB_USER=patent_sweep_usuario
# Cambie esta clave.
DB_PASSWORD=cambiar_clave_de_la_base_de_datos
# Máximo de conexiones del pool HikariCP.
DB_POOL_MAX=10

# Seguridad JWT (ADR-008). Cambie el secreto: debe tener al menos 32 caracteres.
JWT_SECRET=cambiar_este_secreto_jwt_por_un_valor_largo_y_aleatorio
JWT_EXPIRACION_MINUTOS=60
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambiar_clave_del_administrador
SERVICIO_USUARIO=fabricacion
SERVICIO_CLAVE=cambiar_clave_del_servicio

# Integraciones: el nombre apis-simuladas se resuelve dentro de la red de Docker Compose.
MATERIALES_URL=http://apis-simuladas:8080
FUENTE_PATENTES_URL=http://apis-simuladas:8080
